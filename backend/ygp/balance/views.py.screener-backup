def start_screener_downloads(request):
    from datetime import datetime

    global SCREENER_JOB_STATUS

    if SCREENER_JOB_STATUS["status"] == "running":
        return JsonResponse({"status": "already_running"})

    symbols = list(CompanySymbol.objects.values_list("symbol", flat=True))
    download_dir = os.path.join(settings.BASE_DIR, "screener_downloads")
    os.makedirs(download_dir, exist_ok=True)

    SCREENER_EMAIL = os.getenv("SCREENER_EMAIL")
    SCREENER_PASSWORD = os.getenv("SCREENER_PASSWORD")
    user_profile = os.getenv("CHROME_USER_DATA_DIR")

    def job():
        global SCREENER_JOB_STATUS
        try:
            SCREENER_JOB_STATUS.update({
                "status": "running",
                "started_at": datetime.utcnow().isoformat(),
                "finished_at": None,
                "success": [],
                "failed": [],
                "error": None,
            })

            result = download_for_symbols(
                symbols=symbols,
                download_dir=download_dir,
                email=SCREENER_EMAIL,
                password=SCREENER_PASSWORD,
                user_data_dir=user_profile,
                headless=True,   # 🚨 MUST be True on Windows service / server
                delay_range=(6, 14),
                per_download_timeout=90,
            )

            SCREENER_JOB_STATUS["success"] = result.get("success", [])
            SCREENER_JOB_STATUS["failed"] = result.get("failed", [])

        except Exception as e:
            SCREENER_JOB_STATUS["status"] = "failed"
            SCREENER_JOB_STATUS["error"] = str(e)

        finally:
            SCREENER_JOB_STATUS["finished_at"] = datetime.utcnow().isoformat()
            if SCREENER_JOB_STATUS["status"] != "failed":
                SCREENER_JOB_STATUS["status"] = "finished"

    threading.Thread(target=job, daemon=True).start()
    return JsonResponse({"status": "started"})



