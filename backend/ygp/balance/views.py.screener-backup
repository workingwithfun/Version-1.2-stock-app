ERROR_CHOICES_MAP = {
    "Missing in NSC": "MISSING_EQUITY",
    "Missing in mapping": "MISSING_COMPANY_SYMBOL",
    "Calculation failed": "CALCULATION_FAILED",
    "Screener download failed": "SCREENER_DOWNLOAD_FAILED",
